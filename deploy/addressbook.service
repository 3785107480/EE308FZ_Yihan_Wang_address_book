[Unit]
Description=Yihan Wang Address Book
After=network.target

[Service]
Type=simple
User=addressbook
Group=addressbook
WorkingDirectory=/opt/yihan-addressbook
Environment=ADDRESSBOOK_DB=/var/lib/yihan-addressbook/addressbook.db
EnvironmentFile=-/etc/yihan-addressbook.env
ExecStart=/opt/yihan-addressbook/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 --timeout 60 --access-logfile - --error-logfile - wsgi:application
Restart=on-failure
RestartSec=3
StateDirectory=yihan-addressbook
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
